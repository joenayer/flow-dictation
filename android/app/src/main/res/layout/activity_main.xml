<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Flow"
                android:textAppearance="@style/Flow.AppTitle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Settings" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Speech to text, on your phone."
            android:textAppearance="@style/Flow.Support" />

        <LinearLayout
            android:id="@+id/setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set up your microphone"
                android:textAppearance="@style/Flow.SectionTitle" />

            <TextView
                android:id="@+id/setup_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Flow needs microphone access. Speech is processed on this device."
                android:textAppearance="@style/Flow.Support" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_permission"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Allow microphone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/model_setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Set up speech recognition"
                android:textAppearance="@style/Flow.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Download the recommended Parakeet speech model and Silero pause detection. Together they use about 483 MB of internet data and 1.8 GB of free phone storage while installing. Flow verifies both files. You can still use Settings, history, and text tools while setup runs."
                android:textAppearance="@style/Flow.Support" />

            <TextView
                android:id="@+id/model_setup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="Nothing downloads until you tap the button."
                android:textAppearance="@style/Flow.Support" />

            <ProgressBar
                android:id="@+id/model_setup_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Speech model download progress"
                android:max="100"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_setup_start"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                android:text="Download recommended setup" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/model_setup_cancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Pause setup"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Flow.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="Ready to record"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="English · Offline"
                    android:textAppearance="@style/Flow.Support" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/record_level"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="Microphone sound level while listening"
                    android:max="100"
                    android:progressTint="@color/flow_primary"
                    android:visibility="gone"
                    app:trackColor="@color/flow_container"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <ProgressBar
                    android:id="@+id/processing_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="Transcription in progress"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/processing_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/Flow.Support"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_talk"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="64dp"
                    android:text="Start recording" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="Discard recording"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap to start. Tap again to finish."
                    android:textAppearance="@style/Flow.Support" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/bubble_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="56dp"
            android:text="@string/floating_microphone_title" />

        <TextView
            android:id="@+id/bubble_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manual_bubble_help"
            android:textAppearance="@style/Flow.Support" />

        <TextView
            android:id="@+id/automatic_typing_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/automatic_typing_main_off"
            android:textAppearance="@style/Flow.Support" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_automatic_typing"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/automatic_typing_setup" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Transcript"
            android:textAppearance="@style/Flow.SectionTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Dictate, then edit your text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/transcript_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="8"
                android:minLines="4"
                android:scrollbars="vertical" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_copy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="4dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:text="Copy text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="4dp"
                android:insetRight="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:text="Share" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="4dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:text="Save edits" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="4dp"
                android:insetRight="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:text="Export text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_original"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="4dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:text="@string/show_original" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_history"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetLeft="4dp"
                android:insetRight="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:text="Open history" />
        </LinearLayout>

        <TextView
            android:id="@+id/history_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No saved dictations yet."
            android:textAppearance="@style/Flow.Support" />
    </LinearLayout>
</ScrollView>

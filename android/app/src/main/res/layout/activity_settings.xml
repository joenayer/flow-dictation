<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Back"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="start" android:text="Settings" android:textAppearance="@style/Flow.Title"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Appearance" android:textAppearance="@style/Flow.SectionTitle" android:layout_marginTop="24dp"/>
        <RadioGroup android:id="@+id/theme_mode_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/theme_light" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Light"/>
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/theme_dark" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Dark"/>
            <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/theme_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="System"/>
        </RadioGroup>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="System follows your phone’s appearance setting." android:textAppearance="@style/Flow.Body" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/automatic_typing_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_typing_title" android:textAppearance="@style/Flow.SectionTitle" android:layout_marginTop="32dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_typing_disclosure" android:textAppearance="@style/Flow.Body" android:layout_marginTop="12dp"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/automatic_typing_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/automatic_typing_switch"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_typing_help" android:textAppearance="@style/Flow.Body"/>
        <TextView android:id="@+id/automatic_typing_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_typing_off" android:textAppearance="@style/Flow.Body" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/automatic_typing_settings" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/automatic_typing_enable" android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/automatic_typing_restricted_help" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/automatic_typing_restricted_help"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recording" android:textAppearance="@style/Flow.SectionTitle" android:layout_marginTop="32dp"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/hold_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="Hold to talk in Flow"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Off: tap to start and stop on the recording screen. On: press and hold. Choose floating button gestures separately below." android:textAppearance="@style/Flow.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/bubble_controls" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Floating button controls" android:layout_marginTop="8dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speech model" android:textAppearance="@style/Flow.SectionTitle" android:layout_marginTop="32dp"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/cleanup_prompt_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="Clean up into concise prompt"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Off by default. Removes obvious fillers and short repeated starts on your phone. Does not rewrite meaning or fix grammar. Review the result before using it." android:textAppearance="@style/Flow.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/idle_unload" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Free speech model after 2 min idle"/>
        <RadioGroup android:id="@+id/rg_models" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tv_model_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textAppearance="@style/Flow.Body" android:layout_marginTop="12dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/model_offline_help" android:textAppearance="@style/Flow.Body"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/model_import_help" android:textAppearance="@style/Flow.Body" android:layout_marginTop="16dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/model_download" style="@style/Widget.Material3.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/model_download" android:layout_marginTop="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/import_model" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/import_model"/>
        <TextView android:id="@+id/model_import_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textAppearance="@style/Flow.Body" android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/model_cancel" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/model_cancel" android:visibility="gone"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Privacy &amp; history" android:textAppearance="@style/Flow.SectionTitle" android:layout_marginTop="32dp"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/history_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="Save dictation history"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="History stays inside Flow, with up to 200 entries. Turning this off stops new entries; delete existing history separately. Backups are disabled." android:textAppearance="@style/Flow.Body"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/clear_history" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Delete all history" android:layout_marginTop="24dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/app_permissions" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Manage phone permissions"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/check_updates" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/check_updates" android:layout_marginTop="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/check_updates_help" android:textAppearance="@style/Flow.Body"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dictation_tools" android:textAppearance="@style/Flow.SectionTitle" android:layout_marginTop="32dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/vocabulary" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/custom_vocabulary"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/learn_edits_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/learn_edits"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/boost_quiet_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/boost_quiet"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/sensitive_vad_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/sensitive_vad"/>
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/spoken_commands_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/spoken_commands"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pause_help" android:textAppearance="@style/Flow.Body"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/about" android:textAppearance="@style/Flow.SectionTitle" android:layout_marginTop="32dp"/>
        <TextView android:id="@+id/parakeet_credit" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/parakeet_credit" android:textAppearance="@style/Flow.Body"/>
        <TextView android:id="@+id/app_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Flow · On-device dictation" android:textAppearance="@style/Flow.Body" android:layout_marginTop="24dp"/>
        <TextView android:id="@+id/model_load_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speech model load time: not measured yet" android:textAppearance="@style/Flow.Body"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Copied text uses the phone clipboard and may be handled by your keyboard. Share and export only when you choose." android:textAppearance="@style/Flow.Body"/>
    </LinearLayout>
</ScrollView>

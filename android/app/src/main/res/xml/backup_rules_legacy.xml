<?xml version="1.0" encoding="utf-8"?>
<!--
  Full backup opt-out for API 26-30 (allowBackup="false" already opts
  out everywhere; this file exists so lint's DataExtractionRules check is
  satisfied explicitly on every supported API level).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
